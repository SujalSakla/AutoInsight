# Copy this file to backend/.env and fill in your credentials.
# NEVER put a real API key in this file — it is committed to source control.
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
AI_SESSION_TTL_HOURS=24
AI_MAX_UPLOAD_MB=25
AI_LLM_TIMEOUT_S=60
AI_SEND_SAMPLE_ROWS=true
AI_SEND_TOP_VALUES=true
